{
    "version": "0.2.0",
    "configurations": [
        {
            "name": ".NET Core Launch (ERPEZ.Api)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build ERPEZ.Api",
            "program": "${workspaceFolder}/apps/backend/ERPEZ/ERPEZ.Api/bin/Debug/net10.0/ERPEZ.Api.dll",
            "args": [],
            "cwd": "${workspaceFolder}/apps/backend/ERPEZ/ERPEZ.Api",
            "stopAtEntry": false,
            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
            },
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development"
            }
        },
        {
            "name": ".NET Core Launch (TenantManagement.Api)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build TenantManagement.Api",
            "program": "${workspaceFolder}/apps/backend/TenantManagement/ERPEZ.TenantManagement.Api/bin/Debug/net9.0/ERPEZ.TenantManagement.Api.dll",
            "args": [],
            "cwd": "${workspaceFolder}/apps/backend/TenantManagement/ERPEZ.TenantManagement.Api",
            "stopAtEntry": false,
            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
            },
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development"
            }
        },
        {
            "name": ".NET Core Attach",
            "type": "coreclr",
            "request": "attach"
        }
    ]
}