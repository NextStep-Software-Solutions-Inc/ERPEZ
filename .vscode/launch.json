{
    "version": "0.2.0",
    "configurations": [
        {
            "name": ".NET Core Launch (Dashboard.Api)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build Dashboard.Api",
            "program": "${workspaceFolder}/apps/backend/Dashboard/Dashboard.Api/bin/Debug/net9.0/Dashboard.Api.dll",
            "args": [],
            "cwd": "${workspaceFolder}/apps/backend/Dashboard/Dashboard.Api",
            "stopAtEntry": false,
            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
            },
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development"
            }
        },
        {
            "name": ".NET Core Launch (TenantManagement.Api)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build TenantManagement.Api",
            "program": "${workspaceFolder}/apps/backend/TenantManagement/TenantManagement.Api/bin/Debug/net9.0/TenantManagement.Api.dll",
            "args": [],
            "cwd": "${workspaceFolder}/apps/backend/TenantManagement/TenantManagement.Api",
            "stopAtEntry": false,
            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
            },
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development"
            }
        },
        {
            "name": ".NET Core Attach",
            "type": "coreclr",
            "request": "attach"
        }
    ]
}