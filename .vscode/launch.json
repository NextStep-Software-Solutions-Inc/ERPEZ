{
    "version": "0.2.0",
    "configurations": [
        {
            "name": ".NET Core Launch (Dashboard.Api)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/apps/backend/Dashboard/Dashboard.Api/bin/Debug/net10.0/Dashboard.Api.dll",
            "args": [],
            "cwd": "${workspaceFolder}/apps/backend/Dashboard/Dashboard.Api",
            "stopAtEntry": false,
            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "\\bNow listening on:\\s+(https?://\\S+)",
                "uriFormat": "%s/swagger"
            },
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development",
                "ASPNETCORE_URLS": "http://localhost:5245"
            }
        },
        {
            "name": ".NET Core Launch (TenantManagement.Api)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/apps/backend/TenantManagement/TenantManagement.Api/bin/Debug/net10.0/TenantManagement.Api.dll",
            "args": [],
            "cwd": "${workspaceFolder}/apps/backend/TenantManagement/TenantManagement.Api",
            "stopAtEntry": false,
            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "\\bNow listening on:\\s+(https?://\\S+)",
                "uriFormat": "%s/swagger"
            },
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development",
                "ASPNETCORE_URLS": "http://localhost:5246"
            }
        },
        {
            "name": ".NET Core Attach",
            "type": "coreclr",
            "request": "attach"
        }
    ],
    "compounds": [
        {
            "name": "Both APIs (Dashboard + TenantManagement)",
            "configurations": [
                ".NET Core Launch (Dashboard.Api)",
                ".NET Core Launch (TenantManagement.Api)"
            ],
            "stopAll": true
        }
    ]
}