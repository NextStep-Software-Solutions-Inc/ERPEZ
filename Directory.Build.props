<Project>
  <PropertyGroup>
    <!-- Intensified warnings-as-errors policy for repository -->
    <!-- Treat all compiler warnings as errors in CI and local builds unless overridden -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Use highest standard warning level -->
    <WarningLevel>5</WarningLevel>
    <!-- Enable .NET analyzers and fail build on their warnings -->
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <RunAnalyzersDuringBuild>true</RunAnalyzersDuringBuild>
    <RunAnalyzersDuringLiveAnalysis>true</RunAnalyzersDuringLiveAnalysis>
    <CodeAnalysisTreatWarningsAsErrors>true</CodeAnalysisTreatWarningsAsErrors>
    <!-- Enforce code-style rules during build as errors -->
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- Ensure nullable reference types are enabled by default -->
    <Nullable>enable</Nullable>
    <!-- Deterministic builds preferred -->
    <Deterministic>true</Deterministic>
  </PropertyGroup>
</Project>
