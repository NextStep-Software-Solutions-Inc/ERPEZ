<Project>
  <PropertyGroup>
    <!-- Intensified warnings-as-errors policy for repository -->
    <!-- Treat all compiler warnings as errors in CI and local builds unless overridden -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Use highest standard warning level -->
    <WarningLevel>5</WarningLevel>
    <!-- Enable .NET analyzers and fail build on their warnings -->
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <RunAnalyzersDuringBuild>true</RunAnalyzersDuringBuild>
    <RunAnalyzersDuringLiveAnalysis>true</RunAnalyzersDuringLiveAnalysis>
    <!-- Treat analyzer warnings as errors only in CI to avoid blocking local developer workflows.
      CI environments typically set the 'CI' environment variable to 'true'. -->
    <CodeAnalysisTreatWarningsAsErrors Condition="'$(CI)' == 'true'">true</CodeAnalysisTreatWarningsAsErrors>
    <!-- Enforce code-style rules during build as errors only in CI -->
    <EnforceCodeStyleInBuild Condition="'$(CI)' == 'true'">true</EnforceCodeStyleInBuild>
    <!-- Ensure nullable reference types are enabled by default -->
    <Nullable>enable</Nullable>
    <!-- Deterministic builds preferred -->
    <Deterministic>true</Deterministic>
  </PropertyGroup>
</Project>
