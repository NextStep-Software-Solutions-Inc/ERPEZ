# Testing Supplier ID (Optional)
# Specify a Supplier GUID to use as the active supplier identity in Supplier Portal (RFQ Item, etc.)
# If left unset, the Supplier Portal UI lets you dynamically select from any registered supplier.
# VITE_TEST_SUPPLIER_ID=00000000-0000-0000-0000-000000000000

# Tenant Management Portal UI Target URL
# Local: http://localhost:5173
# Dev: https://erpez-portal.vercel.app
# Prod: https://erpez.net
VITE_TENANT_MANAGEMENT_URL=http://localhost:5173

# Dashboard Backend API Base URL
# Local: http://localhost:5245
# Dev: https://erpez-app.api.dev.nextstep-software.com
# Prod: https://app.api.erpez.net
VITE_ERPEZ_BACKEND_URL=http://localhost:5245
VITE_API_URL=http://localhost:5245

# Tenant Management Backend API Base URL
# Local: http://localhost:5246
# Dev: https://erpez-portal.api.dev.nextstep-software.com
# Prod: https://portal.api.erpez.net
VITE_TENANT_API_URL=http://localhost:5246

# Fallback Keycloak configuration (only active when VITE_AUTH_PROVIDER=keycloak)
VITE_KEYCLOAK_URL=placeholder
VITE_KEYCLOAK_REALM=erpez
VITE_KEYCLOAK_CLIENT_ID=web-client
VITE_ENABLE_DEV_PERSONAS=false
