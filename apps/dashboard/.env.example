# ERPEZ Dashboard Environment Variables

# Backend API Base URL
VITE_API_URL=http://localhost:5000

# Testing Supplier ID (Optional)
# Specify a Supplier GUID to use as the active supplier identity in Supplier Portal (RFQ Item, etc.)
# If left unset, the Supplier Portal UI lets you dynamically select from any registered supplier.
# VITE_TEST_SUPPLIER_ID=00000000-0000-0000-0000-000000000000
# VITE_PLATFORM_ADMIN_EMAILS=admin@example.com
