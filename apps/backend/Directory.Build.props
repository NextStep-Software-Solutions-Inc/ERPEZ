<Project>
  <PropertyGroup>
    <!-- Flexible warnings policy allowing naming flexibility -->
    <!-- Only treat warnings as errors in CI environment, not locally -->
    <TreatWarningsAsErrors Condition="'$(CI)' == 'true'">true</TreatWarningsAsErrors>
    <TreatWarningsAsErrors Condition="'$(CI)' != 'true'">false</TreatWarningsAsErrors>
    <!-- Do not fail restore on NuGet vulnerability audit warnings -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
    <!-- Use highest standard warning level -->
    <WarningLevel>5</WarningLevel>
    <!-- Enable .NET analyzers and fail build on their warnings -->
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <RunAnalyzersDuringBuild>true</RunAnalyzersDuringBuild>
    <RunAnalyzersDuringLiveAnalysis>true</RunAnalyzersDuringLiveAnalysis>
    <!-- Treat analyzer warnings as errors locally for strict code quality -->
    <CodeAnalysisTreatWarningsAsErrors>true</CodeAnalysisTreatWarningsAsErrors>
    <!-- Enforce code-style rules during build as errors always (not just in CI) -->
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- Ensure nullable reference types are enabled by default -->
    <Nullable>enable</Nullable>
    <!-- Deterministic builds preferred -->
    <Deterministic>true</Deterministic>
  </PropertyGroup>
</Project>
