{
  "name": "erpez-shared-lib",
  "version": "1.0.0",
  "description": "A shared library for ERP functionalities.",
  "main": "dist/erpez-shared-lib.cjs.js",
  "module": "dist/erpez-shared-lib.esm.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/erpez-shared-lib.esm.js",
      "require": "./dist/erpez-shared-lib.cjs.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c --watch",
    "lint": "eslint .",
    "test": "jest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yourusername/erpez-shared-lib.git"
  },
  "keywords": [
    "erp",
    "library",
    "shared",
    "react-query"
  ],
  "author": "Your Name",
  "license": "MIT",
  "dependencies": {
    "@tanstack/react-query": "^5.90.2",
    "@tanstack/react-query-devtools": "^5.90.2",
    "@tanstack/react-table": "^8.21.3",
    "axios": "^1.12.2"
  },
  "devDependencies": {
    "@rollup/plugin-alias": "^6.0.0",
    "@rollup/plugin-commonjs": "^28.0.6",
    "@rollup/plugin-node-resolve": "^16.0.2",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^12.1.4",
    "@types/react": "^19.1.2",
    "eslint": "^7.0.0",
    "jest": "^26.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "rollup": "^4.52.5",
    "rollup-plugin-dts": "^6.3.0",
    "tslib": "^2.8.1",
    "typescript": "^4.0.0"
  },
  "peerDependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "files": [
    "dist"
  ],
  "homepage": "https://github.com/yourusername/erpez-shared-lib#readme",
  "bugs": {
    "url": "https://github.com/yourusername/erpez-shared-lib/issues"
  }
}